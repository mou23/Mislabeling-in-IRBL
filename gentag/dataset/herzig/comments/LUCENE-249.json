          "id": "12321770",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=alan%40collison.net",
            "name": "alan@collison.net",
            "key": "alan@collison.net",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
