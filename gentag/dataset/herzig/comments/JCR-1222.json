    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12382864/comment/12543893",
          "id": "12543893",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "Inverting lucene documents is not done with the help of a thread pool. The size of the pool is equal to the number of processors. The pool size is automatically adjusted if the number of available processors changes. E.g. processor affinity is changed.\n\nsvn revision: 596654",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2007-11-20T13:51:59.650+0000",
          "updated": "2007-11-20T13:51:59.650+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12382864/comment/12543894",
          "id": "12543894",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "The diagram shows the running times for re-indexing 20'000 nodes.\n\nThe first test used nodes with about 2kB of text, whereas the second test used text with about 12kB text.\n\nEach test was performed with:\n- process bound to single core\n- process uses both cores with current codebase\n- process uses both cores with changes from JCR-1222",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2007-11-20T13:56:35.921+0000",
