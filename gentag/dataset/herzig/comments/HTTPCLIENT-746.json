        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12388430/comment/12574395",
          "id": "12574395",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sdmiski",
            "name": "sdmiski",
            "key": "sdmiski",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
