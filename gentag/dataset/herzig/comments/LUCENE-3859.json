        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12545898/comment/13226871",
          "id": "13226871",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Updated patch: same approach as before, except with some related cleanups.\n\nFieldInfos are now public from IndexReader in 4.0, but javadoc is sparse and some naming is inconsistent.\n\nPatch renames FieldInfos.anyDocValuesFields() to FieldInfos.hasDocValues(), consistent with hasProx(), hasNorms(), and hasFreq().\n\nPatch also renames FieldInfo.normsPresent() to FieldInfo.hasNorms(), consistent with hasDocValues(), and consistent with the naming in FieldInfoS.\n\nAlso i added some additional javadoc.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
