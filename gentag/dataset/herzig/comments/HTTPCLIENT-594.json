              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ortwin Glueck",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2006-08-07T11:21:44.000+0000",
          "updated": "2006-08-07T11:21:44.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12347423/comment/12426307",
          "id": "12426307",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "I'm with Odi. No need for an emergency release if nobody is experiencing problems.\nI haven't used volatile since the times when I was programming in C and assembler,\nand I don't remember having Java threading issues because of that.\n\nStill, I'll keep it in mind and silently put some volatile declarations into HttpAsync :-)\n\ncheers,\n  Roland\n",
