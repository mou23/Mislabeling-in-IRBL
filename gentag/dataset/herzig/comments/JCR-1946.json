        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12412858/comment/12665604",
          "id": "12665604",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=michael.xue",
            "name": "michael.xue",
            "key": "michael.xue",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
