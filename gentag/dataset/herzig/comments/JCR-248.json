            "displayName": "Costin Leau",
            "active": true,
            "timeZone": "Europe/Helsinki"
          },
          "body": "But you can create an InputSource based on an InputStream (i.e. InputSource xmlSource = new InputSource(myInputStream); ). Am I missing something here?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=costin.leau",
            "name": "costin.leau",
            "key": "costin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
