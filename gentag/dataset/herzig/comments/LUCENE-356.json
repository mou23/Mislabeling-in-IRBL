          },
          "body": "Could you please either check if the problem persists with the latest version \nfrom subversion or submit a small test case that makes this easy to reproduce? ",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=daniel.naber%40t-online.de",
            "name": "daniel.naber@t-online.de",
            "key": "daniel.naber@t-online.de",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
