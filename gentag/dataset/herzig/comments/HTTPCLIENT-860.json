        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12430051/comment/12730657",
          "id": "12730657",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=benlperkins",
            "name": "benlperkins",
            "key": "benlperkins",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ben Perkins",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Extensibility is one of the things that drew me to this client.  It's unfortunate that the redirect mechanism isn't quite extensible enough right now to accomplish what I need.  I'll open an enhancement request for 4.1.\n\nThanks,\nBen",
