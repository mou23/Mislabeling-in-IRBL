    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12495021/comment/12979251",
          "id": "12979251",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=adriano_crestani",
            "name": "adriano_crestani",
            "key": "adriano_crestani",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Adriano Crestani",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Here is the fix for the problem raised at thread [1]. The patch also includes a junit to make sure the problem doesn't show up again.\n\nIf there are no concerns in two days, I will go ahead and commit the patch.\n\n[1] - http://lucene.markmail.org/thread/mbb5wlxttsa6sges",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=adriano_crestani",
            "name": "adriano_crestani",
            "key": "adriano_crestani",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
