              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2008-08-27T11:33:31.632+0000",
          "updated": "2008-08-27T11:33:31.632+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12387930/comment/12630779",
