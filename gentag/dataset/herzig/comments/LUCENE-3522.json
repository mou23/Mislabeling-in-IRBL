    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12527391/comment/13128667",
          "id": "13128667",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=aberdeen61",
