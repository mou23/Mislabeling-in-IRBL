              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jukkaz&avatarId=15130",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jukkaz&avatarId=15130",
