          "body": "fixed in rev. 157730 ",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
