          "self": "https://issues.apache.org/jira/rest/api/2/issue/12415049/comment/12674627",
          "id": "12674627",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=weertj",
            "name": "weertj",
            "key": "weertj",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Jacco van Weert",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "\nHello Thomas,\n\nI looked to the repository.xml. You are right, the repository.xml wasn't configured to use the datastore.\n\nIs there a \"programmatic\" way to detect if the GarbageCollector could run?\n\nGreetings,\n\n   Jacco\n\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=weertj",
            "name": "weertj",
            "key": "weertj",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
