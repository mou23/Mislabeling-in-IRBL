          },
          "body": "here is a patch",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=simonw",
            "name": "simonw",
            "key": "simonw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Simon Willnauer",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2010-01-07T16:32:05.285+0000",
          "updated": "2010-01-07T16:32:05.285+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12444932/comment/12797684",
          "id": "12797684",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=simonw",
            "name": "simonw",
            "key": "simonw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Simon Willnauer",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Updated patch. This patch does not count==0 check in contains(Object) as the o.toString() could return null and the NPE would be silently swallowed if the set is empty. \nThe null check and NPE are necessary to yield consistent behavior no matter if the set is empty or not.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=simonw",
            "name": "simonw",
            "key": "simonw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Simon Willnauer",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2010-01-07T17:01:59.768+0000",
          "updated": "2010-01-07T17:01:59.768+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12444932/comment/12797686",
          "id": "12797686",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Simon I like it. this is useful for things like empty stopword sets, so we do not hash every input token unnecessarily.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
