      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12444932/comment/12797675",
          "id": "12797675",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=simonw",
            "name": "simonw",
            "key": "simonw",
            "avatarUrls": {
