          "id": "12331150",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=tripod",
            "name": "tripod",
            "key": "tripod",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=tripod&avatarId=17636",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=tripod&avatarId=17636",
