        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333866/comment/12381385",
          "id": "12381385",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "Mohammad,\nYour strategy is absolutely correct: subclass PostMethod, provide try catch\nblock in execute method, call HttpMethodBase#setForceCloseConnection(true)\nor/and simply close the connection that you get as a parameter to the method.\n\nOleg",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
