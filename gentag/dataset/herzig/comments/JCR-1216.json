    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12382530/comment/12616500",
          "id": "12616500",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=thomasm",
