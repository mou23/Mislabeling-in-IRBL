    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12383712/comment/12547472",
          "id": "12547472",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ckiehl",
            "name": "ckiehl",
            "key": "ckiehl",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Christoph Kiehl",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "I'm getting a performance boost of about 40% on big indexes (about 1000000 nodes) using plain arrays instead of ArrayLists because this avoids a lot of object creation. If no one objects I'm going to commit this.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ckiehl",
            "name": "ckiehl",
            "key": "ckiehl",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Christoph Kiehl",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-12-01T14:19:14.877+0000",
          "updated": "2007-12-01T14:19:14.877+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12383712/comment/12547613",
          "id": "12547613",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=aschrijvers",
            "name": "aschrijvers",
            "key": "aschrijvers",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ard Schrijvers",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "40% !! That is quite some performance gain, very nice. I did see quite some CPU time in array list calls during DescendantSelfAxis tests (11% or something I saw was spend in the init() only). \n\n+1 obviously!",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=aschrijvers",
            "name": "aschrijvers",
            "key": "aschrijvers",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ard Schrijvers",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-12-02T11:25:22.113+0000",
          "updated": "2007-12-02T11:25:22.113+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12383712/comment/12547618",
          "id": "12547618",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=aschrijvers",
            "name": "aschrijvers",
            "key": "aschrijvers",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ard Schrijvers",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "By the way: do not think you should commit the patch like it is now : Arrays.copyOf is not supported for java < 1.6. Use System.arraycopy.\n\nFurthermore, I have tested as well, and performance gain is indeed very large! Nice improvement!",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=aschrijvers",
            "name": "aschrijvers",
            "key": "aschrijvers",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ard Schrijvers",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-12-02T12:54:38.832+0000",
          "updated": "2007-12-02T12:54:38.832+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12383712/comment/12547620",
          "id": "12547620",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ckiehl",
            "name": "ckiehl",
            "key": "ckiehl",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Christoph Kiehl",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Ah, you are certainly right. I'll use System.arraycopy instead. Thanks for the pointer!",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ckiehl",
            "name": "ckiehl",
            "key": "ckiehl",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
