          "updated": "2009-08-03T16:03:27.396+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12432055/comment/12738447",
          "id": "12738447",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=shaie",
            "name": "shaie",
