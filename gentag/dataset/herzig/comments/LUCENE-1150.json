    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12387128/comment/12562424",
          "id": "12562424",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=hibou",
            "name": "hibou",
            "key": "hibou",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=hibou&avatarId=15047",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=hibou&avatarId=15047",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=hibou&avatarId=15047",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=hibou&avatarId=15047"
            },
            "displayName": "Nicolas Lalev\u00e9e",
            "active": true,
            "timeZone": "Europe/Paris"
          },
          "body": "here is my workaround until it is fixed into the Lucene API :\n{code:java}\npackage org.apache.lucene.analysis.standard;\n\npublic class TokenTypeAccessor {\n\n    public static final String APOSTROPHE_TYPE = StandardTokenizerImpl.TOKEN_TYPES[StandardTokenizerImpl.APOSTROPHE];\n\n    public static final String ACRONYM_TYPE = StandardTokenizerImpl.TOKEN_TYPES[StandardTokenizerImpl.ACRONYM];\n\n    public static final String HOST_TYPE = StandardTokenizerImpl.TOKEN_TYPES[StandardTokenizerImpl.HOST];\n\n}\n{code}\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=hibou",
            "name": "hibou",
            "key": "hibou",
            "avatarUrls": {
