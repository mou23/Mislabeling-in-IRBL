    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12313651/comment/12319693",
          "id": "12319693",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "Proposed patch on SharedItemStateManager.\n\nThe write lock is downgraded to a read lock before the listeners are notified. That way, the SharedItemStateManager is effectively released for read access, but does not allow modification while the synchronous listeners are notified, giving them a consistent view of the transaction that just completed.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2005-08-23T17:51:45.000+0000",
          "updated": "2005-08-23T17:51:45.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12313651/comment/12319701",
          "id": "12319701",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=dpfister",
            "name": "dpfister",
            "key": "dpfister",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Dominique Pfister",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "Modified LockManagerImpl to not synchronize when updating content since this can clash with the synchronous event listener being called during a store operation.\n\nFixed in release 239389.",
