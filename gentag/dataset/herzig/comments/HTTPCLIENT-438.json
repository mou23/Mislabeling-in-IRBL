          "body": "Bullshit. Look at: \nhttp://jakarta.apache.org/commons/httpclient/3.0/dependencies.html",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=oglueck",
            "name": "oglueck",
            "key": "oglueck",
            "avatarUrls": {
