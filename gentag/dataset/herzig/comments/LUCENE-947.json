        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12372820/comment/12515099",
          "id": "12515099",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
