              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=hossman&avatarId=21247"
            },
            "displayName": "Chris M. Hostetter",
            "active": true,
            "timeZone": "America/Phoenix"
          },
