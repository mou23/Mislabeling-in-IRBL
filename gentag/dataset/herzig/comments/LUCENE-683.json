    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12353203/comment/12442426",
          "id": "12442426",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yseeley%40gmail.com",
            "name": "yseeley@gmail.com",
            "key": "yseeley@gmail.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Yonik Seeley",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Ouch!\nThere is a very serious bug somewhere... I briefly checked out this test and expanded it, and you aren't even guaranteed to get back the same data you put in!\n\nI'll try and look into it further.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yseeley%40gmail.com",
            "name": "yseeley@gmail.com",
            "key": "yseeley@gmail.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Yonik Seeley",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2006-10-15T22:00:05.000+0000",
          "updated": "2006-10-15T22:00:05.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12353203/comment/12442429",
          "id": "12442429",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yseeley%40gmail.com",
            "name": "yseeley@gmail.com",
            "key": "yseeley@gmail.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Yonik Seeley",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Found it... the thread local that held the fieldsStream was static, and hence not bound to any particular FieldsReader!\nEssentially that means that the offset and size were read from a random segment, not necessarily the segment the field value was stored in.\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yseeley%40gmail.com",
            "name": "yseeley@gmail.com",
            "key": "yseeley@gmail.com",
