            "self": "https://issues.apache.org/jira/rest/api/2/user?username=goller%40detego-software.de",
            "name": "goller@detego-software.de",
            "key": "goller@detego-software.de",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
