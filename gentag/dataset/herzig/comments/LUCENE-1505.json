      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12411485/comment/12720359",
          "id": "12720359",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=simonw",
            "name": "simonw",
            "key": "simonw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Simon Willnauer",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "This issue depends on LUCENE_1496 which is set to won't_fix. I guess I can close / resolve this too. \nAny concers? Speak up please!\n\nsimon",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=simonw",
            "name": "simonw",
            "key": "simonw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Simon Willnauer",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2009-06-16T21:28:29.364+0000",
          "updated": "2009-06-16T21:28:29.364+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12411485/comment/12720572",
          "id": "12720572",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael McCandless",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "LUCENE-1496 is \"won't fix\" because trie's NumericUtils subsumes Solr's NumberUtils, ie, we now need to migrate local lucene to NumericUtils.  And we want to do this for 2.9, since local lucene is not yet released and we have the freedom to make such an otherwise drastic change to the index format.\n\nI'll update this issue to reflect it's new goal.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael McCandless",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2009-06-17T09:03:21.913+0000",
          "updated": "2009-06-17T09:03:21.913+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12411485/comment/12731022",
          "id": "12731022",
          "author": {
