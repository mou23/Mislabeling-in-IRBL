            },
            "displayName": "Michael D\u00fcrig",
            "active": true,
            "timeZone": "Europe/Bucharest"
          },
          "created": "2009-04-23T11:23:51.842+0000",
          "updated": "2009-04-23T11:23:51.842+0000"
