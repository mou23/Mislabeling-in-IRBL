        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/28051/comment/54789",
          "id": "54789",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=fmeschbe",
            "name": "fmeschbe",
            "key": "fmeschbe",
            "avatarUrls": {
