        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12433840/comment/12746949",
          "id": "12746949",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sebb",
            "name": "sebb",
            "key": "sebb@apache.org",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
