          "body": "attached patch.\n\nfair warning;, it also contains some cosmetics involving Comparable (my eyes hurt from all those warnings in eclipse :)",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stillalex",
            "name": "stillalex",
            "key": "alex.parvulescu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=alex.parvulescu&avatarId=41133",
