        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12317825/comment/12417006",
          "id": "12417006",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=hossman",
            "name": "hossman",
            "key": "hossman",
            "avatarUrls": {
