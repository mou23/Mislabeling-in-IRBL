    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12331720/comment/12373501",
          "id": "12373501",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "This patch adds DavException to the signature of getRequestDocument(), and attempts to make sure that an exception is thrown when a request body is present but not well-formed (wrapping the InputStream with a BufferedInputStream and peeking at the first byte was the most reliable way I could think of to find out whether there actually was a request body).\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2006-04-07T00:17:19.000+0000",
          "updated": "2006-04-07T00:17:19.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12331720/comment/12373822",
          "id": "12373822",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "commited patch rev. 392905 .\n\nIn addition removed 'todo' mark stating that invalid xml with propfind should result in 404 instead\nof treating as request for all-props.\n\nNote regarding the interface 'DavServletRequest.java':\nMethod signature with 'getRequestDocument' has changed and now allows to throws DavException.\nI think this modification is a) justifiable and b) should not cause major compatibility issues.  The AbstractWebdavServlet as well as all calling methods in the DavServletRequest and extensions  have already been changed to throw DavException before the 1.0 release.\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2006-04-10T16:20:24.000+0000",
          "updated": "2006-04-10T16:20:24.000+0000"
        }
