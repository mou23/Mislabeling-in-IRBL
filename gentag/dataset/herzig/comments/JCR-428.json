      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333348/comment/12378453",
          "id": "12378453",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=frericksm",
            "name": "frericksm",
            "key": "frericksm",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
