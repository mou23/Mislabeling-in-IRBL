      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12429179/comment/12725575",
          "id": "12725575",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
