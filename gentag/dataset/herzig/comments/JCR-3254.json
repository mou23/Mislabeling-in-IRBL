    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12545658/comment/13225263",
          "id": "13225263",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "while i agree that it was useful for problem analysis, i somehow dislike the idea of having the size configurable with the acprovider config.\nthe main reason is that i wouldn't want to be stuck with that implementation which imo has some fundamental drawbacks (e.g. perm eval\nonly calculated on access).\n\nusing a system property for analysis was fine for me if it was not part of an official release but only some sort of analysis-patch that\nis used temporarily. ",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2012-03-08T15:27:08.659+0000",
          "updated": "2012-03-08T15:27:08.659+0000"
        },
        {
