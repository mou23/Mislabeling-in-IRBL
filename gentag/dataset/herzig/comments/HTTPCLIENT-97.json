            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2002-08-13T18:21:05.000+0000",
          "updated": "2002-08-13T18:21:05.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333656/comment/12379594",
          "id": "12379594",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=vmassol",
            "name": "vmassol",
            "key": "vmassol",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=vmassol&avatarId=41198",
