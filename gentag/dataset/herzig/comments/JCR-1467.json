            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "The full story : \n\nhttp://www.mail-archive.com/dev@jackrabbit.apache.org/msg11205.html\n\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=clombart",
            "name": "clombart",
            "key": "clombart",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Christophe Lombart",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2008-03-12T10:19:29.463+0000",
