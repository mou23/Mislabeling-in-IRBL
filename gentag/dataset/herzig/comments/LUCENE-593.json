        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12344127/comment/12415345",
          "id": "12415345",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=kfc",
            "name": "kfc",
            "key": "kfc",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
