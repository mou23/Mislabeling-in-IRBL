          },
          "created": "2010-01-18T17:51:45.287+0000",
          "updated": "2010-01-18T17:51:45.287+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12445845/comment/12801885",
          "id": "12801885",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "hello, i know this is an extremely simple change technically, but i would like to hear if anyone is against this move.\n\nif no one objects i'd like to commit in a few days, to make progress on fixing some of these problems.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2010-01-18T18:13:07.939+0000",
          "updated": "2010-01-18T18:13:07.939+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12445845/comment/12801912",
          "id": "12801912",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=dmsmith",
            "name": "dmsmith",
            "key": "dmsmith",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "DM Smith",
            "active": true,
            "timeZone": "America/Detroit"
          },
          "body": "+1\n\nHowever this is a very minor break in bw compat: drop in jar replacement. The user will have to delete the snowball jar and use the contrib/analyzer one, if not already done.",
