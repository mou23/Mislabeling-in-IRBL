            "timeZone": "Etc/UTC"
          },
          "created": "2006-09-07T13:49:54.000+0000",
          "updated": "2006-09-07T13:49:54.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12349388/comment/12433686",
          "id": "12433686",
          "author": {
