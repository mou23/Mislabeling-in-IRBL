        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12524557/comment/13114205",
          "id": "13114205",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=cmale",
            "name": "cmale",
            "key": "cmale",
            "avatarUrls": {
