          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333889/comment/12381587",
          "id": "12381587",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=becke%40u.washington.edu",
            "name": "becke@u.washington.edu",
            "key": "becke@u.washington.edu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael Becke",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "This change to TRACE is certainly easier code-wise, but I would prefer to leave both at DEBUG and \nswitch to new Logs.  Some logging kits, Log4j for example, do not support TRACE and just substitute \nDEBUG instead.  The current change would only help those people using the other logging kits.\n\nMike",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=becke%40u.washington.edu",
            "name": "becke@u.washington.edu",
            "key": "becke@u.washington.edu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael Becke",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2004-04-12T05:42:34.000+0000",
