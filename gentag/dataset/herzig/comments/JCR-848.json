        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12367406/comment/12512232",
          "id": "12512232",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=eburnette",
            "name": "eburnette",
            "key": "eburnette",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ed Burnette",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Lucene had the same problem (see http://issues.apache.org/jira/browse/LUCENE-490). JavaCC 4.0 broke two of the grammar files, QueryParser.jjt, and XPath.jjt. The attached patch fixes it.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=eburnette",
            "name": "eburnette",
            "key": "eburnette",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ed Burnette",
            "active": true,
