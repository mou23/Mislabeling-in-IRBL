          "id": "12379389",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jsdever%40sympatico.ca",
            "name": "jsdever@sympatico.ca",
            "key": "jsdever@sympatico.ca",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
