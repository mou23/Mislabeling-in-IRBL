            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2007-09-07T12:21:48.732+0000",
          "updated": "2007-09-07T12:21:48.732+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12377241/comment/12525697",
          "id": "12525697",
          "author": {
