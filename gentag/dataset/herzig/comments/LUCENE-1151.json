        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12387130/comment/12628568",
          "id": "12628568",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=marklassau",
            "name": "marklassau",
            "key": "marklassau",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
