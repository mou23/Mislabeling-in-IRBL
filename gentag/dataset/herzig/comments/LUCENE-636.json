          "body": "Patch which includes a class for the Lucene configuration and changes to existing classes so they use the configuration.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jstuyts",
            "name": "jstuyts",
            "key": "jstuyts",
            "avatarUrls": {
