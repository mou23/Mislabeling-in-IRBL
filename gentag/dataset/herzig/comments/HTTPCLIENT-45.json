            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "It's just a small step toward improving the HTTP protocol versioning in \nHttpClient. Folks, let me know what you think. \n\nOleg",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
