          "updated": "2008-03-08T22:57:31.699+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12390517/comment/12576723",
          "id": "12576723",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=doronc",
