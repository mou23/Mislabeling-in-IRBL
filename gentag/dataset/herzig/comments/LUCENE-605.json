          "updated": "2006-06-20T01:54:53.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12344532/comment/12417020",
          "id": "12417020",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=hossman",
            "name": "hossman",
            "key": "hossman",
            "avatarUrls": {
