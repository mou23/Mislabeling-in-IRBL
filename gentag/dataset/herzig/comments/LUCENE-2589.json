          "body": "Simple patch -- uses regexp to parse out a single int param.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
