        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12512975/comment/13064462",
          "id": "13064462",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
