    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12460451/comment/12850585",
          "id": "12850585",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=shaie",
            "name": "shaie",
            "key": "shaie",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
