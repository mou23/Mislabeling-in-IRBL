          "self": "https://issues.apache.org/jira/rest/api/2/issue/12424298/comment/12718381",
          "id": "12718381",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "the 'searchable' settings are now handled on node type level.\n\ncurrently the settings have no effect on what's indexed/what's searchable.\n\ni am not sure whether/how we want to implement the semantics of\nthe 'searchable' node type attributes.\n\nwdyt, marcel?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
