        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12387218/comment/12580084",
          "id": "12580084",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sberlin",
            "name": "sberlin",
            "key": "sberlin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
