      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12499687/comment/12999317",
          "id": "12999317",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "Martin,\nI made changes to ResponseContentEncoding to ensure that 'x-gzip' is treated as a synonym for 'gzip'.\n\nPresently HttpClient does not support the 'compress' coding, but you are very welcome to contribute it.\n\nOleg",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2011-02-25T11:56:04.153+0000",
          "updated": "2011-02-25T11:56:04.153+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12499687/comment/12999331",
          "id": "12999331",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=zdila",
            "name": "zdila",
            "key": "zdila",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=zdila&avatarId=11233",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=zdila&avatarId=11233",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=zdila&avatarId=11233",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=zdila&avatarId=11233"
            },
            "displayName": "Martin Zdila",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "Thanks.\n\nNote: compress can be implemented in the future by LZW algorithm (some example I found: http://algs4.cs.princeton.edu/55compression/LZW.java.html)\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=zdila",
