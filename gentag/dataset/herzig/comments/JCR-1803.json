        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12406303/comment/12639075",
          "id": "12639075",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ppakulski",
            "name": "ppakulski",
            "key": "ppakulski",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Przemyslaw Pakulski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "I fixed it by simply reverting this single line. Doesn't like it but works :).\n\nAlternative solution is to fix the whole existing version storage somehow on low level (PM?), but it must be done differently depending on used persistence manager.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ppakulski",
            "name": "ppakulski",
            "key": "ppakulski",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
