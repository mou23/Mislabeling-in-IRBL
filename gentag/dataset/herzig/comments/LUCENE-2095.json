    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12441709/comment/12782625",
          "id": "12782625",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sanne",
