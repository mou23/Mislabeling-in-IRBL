      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12538818/comment/13188523",
          "id": "13188523",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "Turns out that we have test cases for these operations in the TCK, see org.apache.jackrabbit.test.api.observation.NodeReorderTest. However, these tests have been written in a way that also causes the incorrect reporting of reorder data in the info map.\n\nI wouldn't want to remove this completely, because then other aspects (ADDED/REMOVED events) wouldn't be tested anymore (once we mark the tests as failing in Jackrabbit). Instead, we could refactor the tests to check REMOVED and ADDED independently from MOVED.\n ",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2012-01-18T16:06:47.960+0000",
          "updated": "2012-01-18T16:06:47.960+0000"
        },
