        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12439429/comment/12771533",
          "id": "12771533",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
