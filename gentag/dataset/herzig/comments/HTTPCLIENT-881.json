          "created": "2009-10-16T15:32:54.734+0000",
          "updated": "2009-10-16T15:32:54.734+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12438234/comment/12766599",
          "id": "12766599",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
