          "body": "Attaching test case. It contains two test methods: one without transactions, another using transactions.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rpuch",
            "name": "rpuch",
            "key": "rpuch",
            "avatarUrls": {
