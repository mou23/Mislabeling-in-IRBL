            },
            "displayName": "Mark Miller",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2009-08-31T02:05:03.824+0000",
          "updated": "2009-08-31T02:05:03.824+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12434390/comment/12749420",
          "id": "12749420",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
