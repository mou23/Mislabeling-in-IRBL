            "self": "https://issues.apache.org/jira/rest/api/2/user?username=karl.wettin",
            "name": "karl.wettin",
            "key": "karl.wettin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
