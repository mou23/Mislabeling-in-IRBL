      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12444015/comment/12793627",
          "id": "12793627",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Trivial patch to fix (works with single or multiple locations):\n\n{code}\nIndex: contrib/benchmark/build.xml\n===================================================================\n--- contrib/benchmark/build.xml (revision 892657)\n+++ contrib/benchmark/build.xml (working copy)\n@@ -114,7 +114,7 @@\n     <path id=\"run.classpath\">\n         <path refid=\"classpath\"/>\n         <pathelement location=\"${build.dir}/classes/java\"/>\n-        <pathelement location=\"${benchmark.ext.classpath}\"/>\n+        <pathelement path=\"${benchmark.ext.classpath}\"/>\n     </path>\n \n     <property name=\"task.alg\" location=\"conf/micro-standard.alg\"/>\n{code}",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
