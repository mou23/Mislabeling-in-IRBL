        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12377122/comment/12526314",
          "id": "12526314",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=drauschenbach",
            "name": "drauschenbach",
            "key": "drauschenbach",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
