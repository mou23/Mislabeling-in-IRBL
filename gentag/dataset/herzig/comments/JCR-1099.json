        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12377122/comment/12523905",
          "id": "12523905",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=drauschenbach",
            "name": "drauschenbach",
            "key": "drauschenbach",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "David Rauschenbach",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "body": "The bottom line, I think, is that in my case the jcr2spi bridge is unable to get around to making the getNodeDefinition SPI invocation, because the call to NodeEntry.getWorkspaceId()  at ItemDefinitionProviderImpl.java:90, which would provide the NodeId to use as the second argument, causes the recursion.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=drauschenbach",
            "name": "drauschenbach",
            "key": "drauschenbach",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "David Rauschenbach",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "created": "2007-08-30T18:10:45.895+0000",
          "updated": "2007-08-30T18:10:45.895+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12377122/comment/12524023",
          "id": "12524023",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
