      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12334023/comment/12382358",
          "id": "12382358",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "Ian,\n\nI reran the tests and once again reviewed the patch committed as a fix for bug#\n34262. I found no logical flaws in the code. HttpClient will close the\nconnection ONLY if the server erroneously sends content body with 204 response,\nwhich is a gross violation of the HTTP spec, thus rendering the underlying\nconnection unreliable\n\nOleg",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2005-05-26T20:31:06.000+0000",
          "updated": "2005-05-26T20:31:06.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12334023/comment/12382359",
          "id": "12382359",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ian.bray%40logicacmg.com",
            "name": "ian.bray@logicacmg.com",
            "key": "ian.bray@logicacmg.com",
