        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12357849/comment/12455859",
          "id": "12455859",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=juliusdavies",
            "name": "juliusdavies",
            "key": "juliusdavies",
            "avatarUrls": {
