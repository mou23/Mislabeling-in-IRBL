        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12428303/comment/12800742",
          "id": "12800742",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
