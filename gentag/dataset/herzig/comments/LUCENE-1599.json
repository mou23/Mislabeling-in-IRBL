          "id": "12718948",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=billowgao",
            "name": "billowgao",
            "key": "billowgao",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
