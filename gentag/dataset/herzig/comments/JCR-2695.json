              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=alexander.klimetschek&avatarId=25443",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=alexander.klimetschek&avatarId=25443",
