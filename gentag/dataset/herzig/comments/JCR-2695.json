            "displayName": "Alexander Klimetschek",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "body": "Looks cool! (Well, the test suite, not necessarily the graphs for versions >= 2.0 ;-))\n\nInteresting would also be the 90th percentile value of all runs of a certain test, instead of the mean.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=alexander.klimetschek",
            "name": "alexander.klimetschek",
            "key": "alexander.klimetschek",
