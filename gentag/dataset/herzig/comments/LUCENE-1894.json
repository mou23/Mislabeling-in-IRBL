        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12434969/comment/12752203",
          "id": "12752203",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=markrmiller%40gmail.com",
