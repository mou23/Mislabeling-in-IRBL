        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12406100/comment/12639777",
          "id": "12639777",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
