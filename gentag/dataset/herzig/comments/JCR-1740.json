          "body": "Sorry, my patch was wrong. I'll provide updated patch soon.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=nebolsin",
            "name": "nebolsin",
            "key": "nebolsin",
