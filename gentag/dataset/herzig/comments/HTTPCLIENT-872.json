      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12434776/comment/12751153",
          "id": "12751153",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=gturner",
            "name": "gturner",
            "key": "gturner",
            "avatarUrls": {
