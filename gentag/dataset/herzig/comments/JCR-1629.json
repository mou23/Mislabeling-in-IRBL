              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mduerig&avatarId=13834",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mduerig&avatarId=13834",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mduerig&avatarId=13834"
            },
            "displayName": "Michael D\u00fcrig",
            "active": true,
            "timeZone": "Europe/Bucharest"
          },
          "created": "2008-07-02T14:31:50.540+0000",
          "updated": "2008-07-02T14:31:50.540+0000"
        },
