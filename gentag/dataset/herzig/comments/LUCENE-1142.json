            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "I propose for this patch to be included in Lucene 3.0.0 (3.0.1?)\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=karl.wettin",
            "name": "karl.wettin",
            "key": "karl.wettin",
