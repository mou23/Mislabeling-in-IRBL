          },
          "created": "2007-08-22T12:51:28.837+0000",
          "updated": "2007-08-22T12:51:28.837+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12376551/comment/12522428",
          "id": "12522428",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ckiehl",
            "name": "ckiehl",
            "key": "ckiehl",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
