        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333791/comment/12380677",
          "id": "12380677",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ggregory%40seagullsw.com",
            "name": "ggregory@seagullsw.com",
            "key": "ggregory@seagullsw.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10453",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10453",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10453",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10453"
            },
            "displayName": "ggregory@seagullsw.com",
            "active": false,
            "timeZone": "Etc/UTC"
          },
          "body": "I am configuring a component that uses HttpClient in its guts. This component is\nconfigured via an XML file. We use JAXB to generate XML IO code from an XSD for\nthis XML config file. Right now, the default value in the XSD has to be matched\nby hand to the default values in HttpClient as well as our other settings. I\nwould like to be able to fill in the default values in the XSD based on\nconstants for all of the pieces that must be configured. This means that the\nreal constant definition is in one place and one place only.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ggregory%40seagullsw.com",
            "name": "ggregory@seagullsw.com",
            "key": "ggregory@seagullsw.com",
            "avatarUrls": {
