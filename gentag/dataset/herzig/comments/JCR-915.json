          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ianeboston",
            "name": "ianeboston",
            "key": "ianeboston",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10453",
