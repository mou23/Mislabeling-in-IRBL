          "id": "13069132",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "I would recommend to drop support for the Label header.\n\nSee <http://www.webdav.org/deltav/protocol/rfc3253-issues-list.htm>:\n\n8.3_ LABEL_HEADER\n\t\n...\n\nThe Label header has poorly defined semantics when used with Depth header, and is inconsistent with HTTP variant processing.\n\n...\n\nReplace the Label header with a DAV:labeled-version report.\n\nand draft in\n\n<http://www.webdav.org/deltav/protocol/draft-ietf-webdav-versioning-xx.7.htm>",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
