    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12357154/comment/12454042",
          "id": "12454042",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "Nodes in the query result are now fetched in chunks. The initial chunk can be configured with the parameter 'resultFetchSize'. If a client attempts to read pass the initial chunk the query is executed again and the target chunk size is doubled.\n\nFixed in revision: 480138",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2006-11-28T17:48:27.000+0000",
          "updated": "2006-11-28T17:48:27.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12357154/comment/12454613",
          "id": "12454613",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "I've reverted the changes in QueryResultImpl to provide a backward compatible constructor in that class. The new functionality is now implemented in LazyQueryResultImpl.\n\nCommitted in revision: 480917",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2006-11-30T13:34:49.000+0000",
          "updated": "2006-11-30T13:34:49.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12357154/comment/12459227",
          "id": "12459227",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jukkaz",
            "name": "jukkaz",
            "key": "jukkaz",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=jukkaz&avatarId=15130",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jukkaz&avatarId=15130",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jukkaz&avatarId=15130",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jukkaz&avatarId=15130"
            },
            "displayName": "Jukka Zitting",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Reopened since the fix introduces a security issue.\n\nUsing the query mechanism it is now possible for a user to infer the existence of some content to which access would otherwise be denied.\n\nTo prevent this the query result implementation must by default return -1 from getSize() unless it can avoid counting rows that may get dropped because of access controls. It's OK to add a configuration option that activates the current behaviour, but it must not be enabled by default.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jukkaz",
            "name": "jukkaz",
            "key": "jukkaz",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=jukkaz&avatarId=15130",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jukkaz&avatarId=15130",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jukkaz&avatarId=15130",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jukkaz&avatarId=15130"
            },
            "displayName": "Jukka Zitting",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2006-12-18T08:46:57.000+0000",
          "updated": "2006-12-18T08:46:57.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12357154/comment/12459243",
          "id": "12459243",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "Changed the default value of the 'resultFetchSize' to Integer.MAX_VALUE. With this value getSize() will always return the correct value according to the users access rights.\n\nFixed in trunk and 1.2 branch: 488181",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mreutegg&avatarId=18658",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mreutegg&avatarId=18658",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mreutegg&avatarId=18658",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mreutegg&avatarId=18658"
            },
            "displayName": "Marcel Reutegger",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2006-12-18T09:43:35.000+0000",
          "updated": "2006-12-18T09:43:35.000+0000"
        },
        {
