        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12334026/comment/12382390",
          "id": "12382390",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=gojomo%40archive.org",
            "name": "gojomo@archive.org",
