    "customfield_12311020": null,
    "customfield_12313320": "<div style='font-weight:bold;color:red;text-align:center'>This project has a <a href=\"https://lucene.apache.org/core/discussion.html\">user mailing list and an IRC channel</a> for support. If you are looking for support, or if you are not sure whether the behavior that you are observing is expected or not, please discuss it there first.</div>",
    "customfield_12314134": null,
    "duedate": null,
    "customfield_12314132": null,
    "customfield_12314131": null,
    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12409523/comment/12651899",
          "id": "12651899",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=marklassau",
            "name": "marklassau",
            "key": "marklassau",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Mark Lassau",
            "active": true,
            "timeZone": "Australia/Sydney"
          },
          "body": "The following methods would potentially suffer contention as well depending on usage patterns of the particular app:\n* stringToTime()\n* dateToString()\n* timeToString()\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=marklassau",
            "name": "marklassau",
            "key": "marklassau",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Mark Lassau",
            "active": true,
            "timeZone": "Australia/Sydney"
          },
          "created": "2008-12-01T03:37:33.803+0000",
          "updated": "2008-12-01T03:37:33.803+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12409523/comment/12651900",
          "id": "12651900",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=marklassau",
            "name": "marklassau",
            "key": "marklassau",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Mark Lassau",
            "active": true,
            "timeZone": "Australia/Sydney"
          },
          "body": "[SimpleDateFormat javadoc|http://java.sun.com/javase/6/docs/api/java/text/SimpleDateFormat.html]:\n\n{quote}\nDate formats are not synchronized.\nIt is recommended to create separate format instances for each thread.\nIf multiple threads access a format concurrently, it must be synchronized externally.\n{quote}\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=marklassau",
            "name": "marklassau",
            "key": "marklassau",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Mark Lassau",
            "active": true,
            "timeZone": "Australia/Sydney"
          },
          "created": "2008-12-01T03:42:04.181+0000",
          "updated": "2008-12-01T03:42:04.181+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12409523/comment/12652085",
          "id": "12652085",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=lucenebugs%40danielnaber.de",
            "name": "lucenebugs@danielnaber.de",
            "key": "lucenebugs@danielnaber.de",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Daniel Naber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Could you try changing the code to create a new object every time and then run your load test again? We original did that but it was slower, at least according to this commit comment from two years ago:\n\n\"Don't re-create SimpleDateFormat objects, use static ones instead. Gives about a 2x performance increase in a micro benchmark.\"\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=lucenebugs%40danielnaber.de",
            "name": "lucenebugs@danielnaber.de",
            "key": "lucenebugs@danielnaber.de",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Daniel Naber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2008-12-01T18:29:10.173+0000",
          "updated": "2008-12-01T18:29:10.173+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12409523/comment/12652194",
          "id": "12652194",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=cutting",
            "name": "cutting",
