        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12533879/comment/13163517",
          "id": "13163517",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jukkaz",
            "name": "jukkaz",
            "key": "jukkaz",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=jukkaz&avatarId=15130",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jukkaz&avatarId=15130",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=jukkaz&avatarId=15130",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=jukkaz&avatarId=15130"
            },
            "displayName": "Jukka Zitting",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "So far I haven't figured out a way to make Eclipse and other IDEs pick up the generated sources automatically during an import. Until we have such a patch I think having the precompiled sources in svn under src/main/java is the best solution here.\n\nPS. For future reference: When changing the JavaCC sources, use \"mvn clean install -Pjavacc\" in jackrabbit-spi-commons and commit the updated files.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jukkaz",
            "name": "jukkaz",
            "key": "jukkaz",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=jukkaz&avatarId=15130",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=jukkaz&avatarId=15130",
