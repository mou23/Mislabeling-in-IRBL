            "timeZone": "Etc/UTC"
          },
          "body": "Do you mind making BasicHeader and BufferedHeader also implement Serializable?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=waldbaer",
            "name": "waldbaer",
            "key": "waldbaer",
