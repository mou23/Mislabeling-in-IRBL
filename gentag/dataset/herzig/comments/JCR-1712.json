      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12401870/comment/12620553",
          "id": "12620553",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "with jsr 283 a couple of changes are made to the jcr name:\n\n1) introduce distinction between \"Expanded Form\" and \"Qualified Form\"\n2) change the set of invalid characters\n\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2008-08-07T08:38:43.160+0000",
          "updated": "2008-08-07T08:38:43.160+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12401870/comment/12620568",
          "id": "12620568",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "initial draft for the NameParser, that deals with both expanded and qualified form.\n\n- validation of uri in the expanded form is omitted (as far as i know, we don't\n  do this with the namespace registry currently)\n- not totally sure about cases like \"{}\" and \"{uri}\" where uri would be a known\n  namespace uri.\n\nplease comment.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2008-08-07T09:28:36.379+0000",
          "updated": "2008-08-07T09:28:36.379+0000"
        },
