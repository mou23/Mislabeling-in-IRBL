              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Edgar Ruben Poce",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2005-10-07T10:29:25.000+0000",
