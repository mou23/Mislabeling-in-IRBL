        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12358985/comment/12459931",
          "id": "12459931",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "the following methods are synchronized on the CachingNamespaceResolver \ninstance:\n\nQName retrieveName(String jcrName) \nString retrieveName(QName name) \n \nthis potentially leads to monitor contention since those methods are \nindirectly called by a lot of jcr api methods (such as Node.getProperty() etc).\n\na possible solution would be to replace the internal LRUMap's with \nsomething that's optimized for concurrent read access (e.g.  an LRUMap\nimplementation that is based on doug lea's ConcurrentReaderHashMap).",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2006-12-20T13:19:20.000+0000",
          "updated": "2006-12-20T13:19:20.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12358985/comment/12459943",
          "id": "12459943",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
            "avatarUrls": {
