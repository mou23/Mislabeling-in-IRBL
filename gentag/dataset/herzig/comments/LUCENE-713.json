          "id": "12512745",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=bitbrunch",
            "name": "bitbrunch",
            "key": "bitbrunch",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
