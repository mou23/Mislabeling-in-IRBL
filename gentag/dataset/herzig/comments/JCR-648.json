              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2006-11-29T16:16:19.000+0000",
          "updated": "2006-11-29T16:16:19.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12357059/comment/12454355",
