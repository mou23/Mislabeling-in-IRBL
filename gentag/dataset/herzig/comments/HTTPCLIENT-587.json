    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12344473/comment/12416435",
          "id": "12416435",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=gojomo",
            "name": "gojomo",
