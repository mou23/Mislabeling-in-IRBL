      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12463022/comment/12860935",
          "id": "12860935",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
