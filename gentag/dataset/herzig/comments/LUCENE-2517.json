    "customfield_12314131": null,
    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12468046/comment/12883121",
          "id": "12883121",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "This patch addresses the following issues:\n\n# Release headers (==== Release X.X.X .... ====) can be spelled with \"Lucene\" instead of \"Release\": ==== Lucene X.X.X ... ====\n# Release versions can have .X, .Y or .Z components (e.g. 3.x)\n# JavaScript isOlder() method had a (no longer correct) hard-coded regex to recognize the two latest releases.  This regex is now generated from the two latest releases.\n# <code> -> <code><pre> (to make them look better in HTML) is now blocked for inline usages, so that newlines are not added to the HTML version when they are not present in CHANGES.txt.\n# Imbalanced parentheses were incorrectly recognized as attribution onset.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2010-06-28T12:13:00.160+0000",
          "updated": "2010-06-28T12:13:00.160+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12468046/comment/12883123",
          "id": "12883123",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "This patch contains several typo fixes for CHANGES.txt, and one change: the first item under Changes in backwards compatibility policy (LUCENE-1458, LUCENE-2111, LUCENE-2354: Changes from flexible indexing) includes attribution for individual bulleted items, which is a new usage that I *think* is not intended (copy-paste-o, likely), and several of the people that worked on those three issues are not given credit anywhere AFAICT, so I've moved the attributions attached to bulleted items to below the entire bulleted list, and added everyone who posted a patch to any of the three issues.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2010-06-28T12:17:55.737+0000",
          "updated": "2010-06-28T12:17:55.737+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12468046/comment/12885063",
          "id": "12885063",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
