        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12518949/comment/13085506",
          "id": "13085506",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=cmale",
            "name": "cmale",
            "key": "cmale",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Chris Male",
            "active": true,
            "timeZone": "Pacific/Auckland"
          },
          "body": "My plan was to move the class ReusableAnalyzerBase into core and then port all Analyzers over to using it.  Then I would drop tokenStream() and rename ReusableAnalyzerBase to just Analyzer.\n\nManageable?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=cmale",
            "name": "cmale",
            "key": "cmale",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Chris Male",
            "active": true,
            "timeZone": "Pacific/Auckland"
          },
          "created": "2011-08-16T02:58:12.896+0000",
          "updated": "2011-08-16T02:58:12.896+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12518949/comment/13085520",
          "id": "13085520",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=cmale",
            "name": "cmale",
            "key": "cmale",
