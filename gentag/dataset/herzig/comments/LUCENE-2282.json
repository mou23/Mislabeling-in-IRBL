        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12457218/comment/12837988",
          "id": "12837988",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=marvin",
            "name": "marvin",
            "key": "creamyg",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
