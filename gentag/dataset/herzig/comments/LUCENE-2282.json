          "body": "Forgot to tag IFN as @lucene.internal",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=shaie",
            "name": "shaie",
            "key": "shaie",
            "avatarUrls": {
