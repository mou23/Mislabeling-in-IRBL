          "body": "Proposed fix.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=meteatamel",
            "name": "meteatamel",
            "key": "meteatamel",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=meteatamel&avatarId=13436",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=meteatamel&avatarId=13436",
