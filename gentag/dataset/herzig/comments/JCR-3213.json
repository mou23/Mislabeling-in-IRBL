    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12538943/comment/13189048",
          "id": "13189048",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stillalex",
            "name": "stillalex",
            "key": "alex.parvulescu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=alex.parvulescu&avatarId=41133",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=alex.parvulescu&avatarId=41133",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=alex.parvulescu&avatarId=41133",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=alex.parvulescu&avatarId=41133"
            },
            "displayName": "Alex Deparvu",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "body": "The proposed patch moves up the isIndexed call from the #addValue method to #createDoc.\n\nBefore, it was being called for each value of a property, so for a MVP multiple times, which is suboptimal because the method only relates to the property's name, not its value to determine if it should be indexed or not.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stillalex",
            "name": "stillalex",
            "key": "alex.parvulescu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=alex.parvulescu&avatarId=41133",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=alex.parvulescu&avatarId=41133",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=alex.parvulescu&avatarId=41133",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=alex.parvulescu&avatarId=41133"
            },
            "displayName": "Alex Deparvu",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
