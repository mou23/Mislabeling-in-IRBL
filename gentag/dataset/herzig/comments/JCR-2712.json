        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12471405/comment/12902601",
          "id": "12902601",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sebastianconti",
            "name": "sebastianconti",
            "key": "sebastianconti",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Sebastian Sickelmann",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "I think this bug relates to jackrabbit core. Because the cause of the bug is in  java.org.apache.jackrabbit.core.version.InternalXAVersionManager",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sebastianconti",
            "name": "sebastianconti",
            "key": "sebastianconti",
