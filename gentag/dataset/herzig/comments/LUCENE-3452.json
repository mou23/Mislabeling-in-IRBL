    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12524463/comment/13113697",
          "id": "13113697",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=dweiss",
