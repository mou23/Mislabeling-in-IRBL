            "timeZone": "Europe/Zurich"
          },
          "body": ">  three-argument constructor\n\nah, right. thanks, that explains it.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
