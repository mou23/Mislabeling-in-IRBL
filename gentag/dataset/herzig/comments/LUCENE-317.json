          "body": "Created an attachment (id=13546)\nCheck if writeLock is null before releasing\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=siberski%40learninglab.de",
            "name": "siberski@learninglab.de",
            "key": "siberski@learninglab.de",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
