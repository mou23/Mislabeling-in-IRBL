          },
          "created": "2009-12-04T13:34:13.975+0000",
          "updated": "2009-12-04T13:34:13.975+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12436518/comment/12785924",
          "id": "12785924",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yabon",
            "name": "yabon",
