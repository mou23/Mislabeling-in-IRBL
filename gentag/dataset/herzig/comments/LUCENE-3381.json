      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12519255/comment/13086874",
          "id": "13086874",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=cmale",
