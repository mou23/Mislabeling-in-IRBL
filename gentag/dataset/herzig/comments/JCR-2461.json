    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12445189/comment/12798690",
          "id": "12798690",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mduerig",
            "name": "mduerig",
            "key": "mduerig",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mduerig&avatarId=13834",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mduerig&avatarId=13834",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mduerig&avatarId=13834",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mduerig&avatarId=13834"
            },
            "displayName": "Michael D\u00fcrig",
            "active": true,
            "timeZone": "Europe/Bucharest"
          },
          "body": "The slow down is caused by merging changes of item states from the server with the local ones on the client. The main contribution seems to come from diffing the property states. \n\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mduerig",
            "name": "mduerig",
            "key": "mduerig",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mduerig&avatarId=13834",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mduerig&avatarId=13834",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mduerig&avatarId=13834",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mduerig&avatarId=13834"
            },
            "displayName": "Michael D\u00fcrig",
            "active": true,
            "timeZone": "Europe/Bucharest"
          },
          "created": "2010-01-11T15:28:20.950+0000",
          "updated": "2010-01-11T15:28:20.950+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12445189/comment/12798692",
          "id": "12798692",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mduerig",
            "name": "mduerig",
            "key": "mduerig",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mduerig&avatarId=13834",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mduerig&avatarId=13834",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mduerig&avatarId=13834",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mduerig&avatarId=13834"
            },
            "displayName": "Michael D\u00fcrig",
            "active": true,
            "timeZone": "Europe/Bucharest"
          },
          "body": "This patch disables diffing of property states. Items contained in a batch from the server are set to Status#MODIFIED without establishing whether they differ form their cached values. \n\nI was able to successfully run all tests with the patch applied. However, I'm not sure whether this patch has further, more subtle consequences which I'm not aware of. ",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mduerig",
            "name": "mduerig",
            "key": "mduerig",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=mduerig&avatarId=13834",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=mduerig&avatarId=13834",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=mduerig&avatarId=13834",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=mduerig&avatarId=13834"
            },
            "displayName": "Michael D\u00fcrig",
            "active": true,
            "timeZone": "Europe/Bucharest"
          },
          "created": "2010-01-11T15:32:12.533+0000",
          "updated": "2010-01-11T15:32:12.533+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12445189/comment/12803698",
