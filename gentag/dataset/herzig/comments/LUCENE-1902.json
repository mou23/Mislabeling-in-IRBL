    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12435151/comment/12752753",
          "id": "12752753",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=hossman",
            "name": "hossman",
            "key": "hossman",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=hossman&avatarId=21247",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=hossman&avatarId=21247",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=hossman&avatarId=21247",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=hossman&avatarId=21247"
            },
            "displayName": "Chris M. Hostetter",
            "active": true,
            "timeZone": "America/Phoenix"
          },
          "body": "I'm sick of dealing with forrest.\n\nthis patch does the following things...\n* calls cahnges-to-html from the pacakge target\n* add a link to Changes.html and Contrib-Changes.html in the left nav of the version specific docs\n* fixes a hardcoded link to the public site when refering to the contrib changes in an existing page.\n\nit has the side effect of of causing forrest to freak out that it doesn't know how to create Changes.html ... never mind that i've configured it to be an external page, never mind that there are 100 other external pages configured the same way that work just fine (all of the contrib javadoc pages) ... forrest refuses to play nice with me.\n\nI've taken this as far as i can ... someone else can pick it up if they choose.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=hossman",
            "name": "hossman",
            "key": "hossman",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=hossman&avatarId=21247",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=hossman&avatarId=21247",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=hossman&avatarId=21247",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=hossman&avatarId=21247"
            },
            "displayName": "Chris M. Hostetter",
            "active": true,
            "timeZone": "America/Phoenix"
          },
          "created": "2009-09-08T21:29:58.298+0000",
          "updated": "2009-09-08T21:29:58.298+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12435151/comment/12752762",
          "id": "12752762",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=markrmiller%40gmail.com",
            "name": "markrmiller@gmail.com",
            "key": "markrmiller@gmail.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=markrmiller%40gmail.com&avatarId=17267",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=markrmiller%40gmail.com&avatarId=17267",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=markrmiller%40gmail.com&avatarId=17267",
