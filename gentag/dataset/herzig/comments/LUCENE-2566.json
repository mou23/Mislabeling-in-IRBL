    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12470170/comment/12924204",
          "id": "12924204",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yseeley%40gmail.com",
            "name": "yseeley@gmail.com",
            "key": "yseeley@gmail.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Yonik Seeley",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Here's a patch that stops treating +, -, ! as operators if they  are followed by whitespace.\nEveryone seemed to previously agree about + and -, but I also threw in ! for consistency since it was another single char (largely unknown synonym for NOT) unary operator.  Thoughts?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=yseeley%40gmail.com",
            "name": "yseeley@gmail.com",
            "key": "yseeley@gmail.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Yonik Seeley",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2010-10-23T14:43:25.770+0000",
          "updated": "2010-10-23T14:43:25.770+0000"
        },
        {
