    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12435107/comment/12752518",
          "id": "12752518",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=shaie",
            "name": "shaie",
            "key": "shaie",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Shai Erera",
            "active": true,
            "timeZone": "Asia/Jerusalem"
          },
          "body": "I don't know about doubling the array size every time. There's ArrayUtil.getNextSize (a Lucene class) which seems to grow arrays in a mild fashion. the method is well documented, and I think it should be used by ensureCapacityWords.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=shaie",
            "name": "shaie",
            "key": "shaie",
            "avatarUrls": {
