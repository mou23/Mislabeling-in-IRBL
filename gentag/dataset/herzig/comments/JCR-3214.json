    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12539143/comment/13189843",
          "id": "13189843",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "DomUtil.timeoutToXml:\n\n     * Note, that {@link DavConstants#INFINITE_TIMEOUT} is not represented by the String\n     * {@link DavConstants#TIMEOUT_INFINITE 'Infinite'} defined by RFC 2518, due to a known\n     * issue with Microsoft Office that opens the document \"read only\" and\n     * never unlocks the resource if the timeout is missing or 'Infinite'.\n\nSo what happens is that the servlet internall uses MAX_INT as infinite, but then doesn't treat is as a special value, and also divides by 1000 (ms -> s).\n\nNot sure what's the best fix here; do we know whether Office still has this problem?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2012-01-20T15:06:38.538+0000",
          "updated": "2012-01-20T15:06:38.538+0000"
        },
