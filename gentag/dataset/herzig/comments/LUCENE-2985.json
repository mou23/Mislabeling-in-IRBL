            },
            "displayName": "Simon Willnauer",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2011-03-23T12:39:24.374+0000",
          "updated": "2011-03-23T12:39:24.374+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12502173/comment/13010778",
