            },
            "displayName": "Uwe Schindler",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2011-11-23T12:10:32.544+0000",
          "updated": "2011-11-23T12:10:32.544+0000"
        },
