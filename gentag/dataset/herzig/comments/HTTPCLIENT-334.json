          "body": "*** HTTPCLIENT-448 has been marked as a duplicate of this bug. ***",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
