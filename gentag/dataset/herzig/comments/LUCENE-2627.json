    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12472720/comment/12903499",
          "id": "12903499",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
