          "body": "Committed revision 495531.\n\nAdded a very simple configuration mechanism that asks you for a repository home and lets you either create a new repository or reuse an existing one. in any case, a 'bootstrap.properties' file is written to the repository home which holds all the parameters that were as 'init-params' in the web.xml. thus allowing modification of those parameters without needing to modify the contents of the .war file.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=tripod",
            "name": "tripod",
            "key": "tripod",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=tripod&avatarId=17636",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=tripod&avatarId=17636",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=tripod&avatarId=17636",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=tripod&avatarId=17636"
            },
            "displayName": "Tobias Bocanegra",
            "active": true,
            "timeZone": "Asia/Tokyo"
          },
          "created": "2007-01-12T09:42:04.635+0000",
