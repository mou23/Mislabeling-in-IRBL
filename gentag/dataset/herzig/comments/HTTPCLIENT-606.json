        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12355734/comment/12451269",
          "id": "12451269",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "OK. I see the problem with the patch. The HTTP element charset defaults to US-ASCII, whereas the default URI charset should be UTF-8.\n\nI see no way around adding a new HTTP parameter specifically for the URI charset.\n\nNew patch attached. Please review.\n\nOleg",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
