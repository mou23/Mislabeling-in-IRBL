        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12540991/comment/13199390",
          "id": "13199390",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=wunder",
            "name": "wunder",
            "key": "wunder",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=wunder&avatarId=29703",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=wunder&avatarId=29703",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=wunder&avatarId=29703",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=wunder&avatarId=29703"
            },
            "displayName": "Walter Underwood",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "body": "Why make separate patches for characters instead of using Unicode normalization? Converting to NFKC would also solve this for the prime character (U+2032) and any other codepoint that is equivalent.\n\nCompatibility normalization is designed for precisely this purpose, equivalence ignoring appearance.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=wunder",
            "name": "wunder",
            "key": "wunder",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=wunder&avatarId=29703",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=wunder&avatarId=29703",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=wunder&avatarId=29703",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=wunder&avatarId=29703"
            },
            "displayName": "Walter Underwood",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "created": "2012-02-03T00:13:48.339+0000",
          "updated": "2012-02-03T00:13:48.339+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12540991/comment/13199398",
          "id": "13199398",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Walter: U+2019 does not decompose at all (see http://unicode.org/cldr/utility/character.jsp?a=2019&B1=Show)\n\nThis is because its not a compatibility character of any reason, in fact its the single quote (U+0027) \nthats ambiguous, U+2019 is the correct one here.\n\nFrom a pedantic point of view, we should be forcing you to disambiguate the very ambiguous single quote (U+0027)\non your keyboard and *ONLY* handling U+2019 in this filter, but I realize some people might find this opinion a \ntad extreme :)\n\n\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2012-02-03T00:20:12.234+0000",
          "updated": "2012-02-03T00:20:12.234+0000"
        },
