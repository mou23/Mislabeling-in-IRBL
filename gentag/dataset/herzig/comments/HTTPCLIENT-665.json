    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12373807/comment/12512785",
          "id": "12512785",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Changing attribute visibility in HttpState will only affect applications that extend this class and use the same attribute names.\nIf I am not mistaken, Java allows re-use of attribute names in derived classes, and scoping will make sure that the behavior remains the same as it is now.\nIf there are problems with name clashes, the workaround is to rename the attributes in the derived classes.\n\nBased on the non-impact on existing applications, I am in favor of this change.\n\ncheers,\n  Roland\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-07-15T09:24:34.241+0000",
          "updated": "2007-07-15T09:24:34.241+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12373807/comment/12516449",
          "id": "12516449",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
