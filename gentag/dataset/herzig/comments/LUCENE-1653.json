            },
            "displayName": "Mark Miller",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "Why is this synchronized?\n\n+  public static synchronized Date round(Date date, Resolution resolution) {\n     return new Date(round(date.getTime(), resolution));\n   }\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=markrmiller%40gmail.com",
            "name": "markrmiller@gmail.com",
            "key": "markrmiller@gmail.com",
