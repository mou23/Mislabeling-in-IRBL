    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12547576/comment/13235504",
          "id": "13235504",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stillalex",
            "name": "stillalex",
            "key": "alex.parvulescu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=alex.parvulescu&avatarId=41133",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=alex.parvulescu&avatarId=41133",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=alex.parvulescu&avatarId=41133",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=alex.parvulescu&avatarId=41133"
            },
            "displayName": "Alex Deparvu",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "body": "In the case of a corrupt bundle the ItemStateManager#getItemState can throw an ItemStateException that stops the repository from starting.\n\nMy proposal is to have MultiIndex.createInitialIndex catch the ItemStateException and have it logged via the OnWorkspaceInconsistency handler.\nThe error wouldn't be a blocker anymore and if anybody is looking at the workspace consystency logs will see its message as well.\n\nThe simplest way to do this is to wrap log.error into a public method OnWorkspaceInconsistency#logError and use it from the MultiIndex.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stillalex",
            "name": "stillalex",
            "key": "alex.parvulescu",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=alex.parvulescu&avatarId=41133",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=alex.parvulescu&avatarId=41133",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=alex.parvulescu&avatarId=41133",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=alex.parvulescu&avatarId=41133"
            },
            "displayName": "Alex Deparvu",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "created": "2012-03-22T11:15:57.987+0000",
          "updated": "2012-03-22T11:15:57.987+0000"
