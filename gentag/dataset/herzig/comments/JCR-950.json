      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12370422/comment/12499840",
          "id": "12499840",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "seems to be an o.a,j.core.CachingHierarchyManager issue which seems to be getting out of sync/corrupted somehow.\n\nnote that Workspace.move() does work correctly. it's the current session's view which is inconsistent.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2007-05-29T16:37:53.877+0000",
          "updated": "2007-05-29T16:37:53.877+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12370422/comment/12500074",
          "id": "12500074",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "passing on to the CachingHierarchyManager expert ;)",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2007-05-30T09:13:09.366+0000",
          "updated": "2007-05-30T09:13:09.366+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12370422/comment/12500163",
          "id": "12500163",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=dpfister",
            "name": "dpfister",
            "key": "dpfister",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Dominique Pfister",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "There was some bad assumption in the PathMap (located in jackrabbit-jcr-commons): after moving /node1 to /result, the CachingHierarchyManager determined that its internal representation of the root tnode had become invalid and therefore told its PathMap to remove it. The PathMap has some check to prevent the root node from being completely removed, but unfortunately forgot to remove its children and associated object, which left an orphaned \"node1\" child in the root node's children map.\n\nFixed in revision 542838.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=dpfister",
            "name": "dpfister",
            "key": "dpfister",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Dominique Pfister",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2007-05-30T15:21:34.508+0000",
          "updated": "2007-05-30T15:21:34.508+0000"
        },
