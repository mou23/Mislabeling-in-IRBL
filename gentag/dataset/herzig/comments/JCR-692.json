              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ted Leung",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2006-12-29T15:30:05.000+0000",
          "updated": "2006-12-29T15:30:05.000+0000"
