          "updated": "2007-06-04T20:28:23.818+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12370800/comment/12501380",
          "id": "12501380",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=michaelbusch",
