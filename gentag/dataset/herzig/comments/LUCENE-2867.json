    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12495506/comment/12981534",
          "id": "12981534",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=adriano_crestani",
            "name": "adriano_crestani",
            "key": "adriano_crestani",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Adriano Crestani",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Here is the patch that deprecates methods using CharSequence. Can someone please review if I did the API deprecation correctly?\n\nI was thinking initially that deprecated methods would be removed on version 4, I'm not sure anymore. Will it be removed on 4 or 3.1?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=adriano_crestani",
            "name": "adriano_crestani",
            "key": "adriano_crestani",
            "avatarUrls": {
