          "updated": "2010-03-13T09:51:08.427+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12442972/comment/12845715",
          "id": "12845715",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jessewilson",
            "name": "jessewilson",
            "key": "jessewilson",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Jesse Wilson",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Oleg,\n\nI'm Bob's successor on the Android team. If you've got questions about our use of the HTTP client code, I'll do my best to answer 'em. I regret that we haven't given this code much attention lately; that said I'm happy that it hasn't really needed it.\n\n",
