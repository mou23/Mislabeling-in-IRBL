          "id": "12608265",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sberlin",
            "name": "sberlin",
            "key": "sberlin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
