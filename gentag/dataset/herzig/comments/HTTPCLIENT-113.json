      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333672/comment/12379644",
          "id": "12379644",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=oglueck",
            "name": "oglueck",
            "key": "oglueck",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ortwin Glueck",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "body": "The primary problem is probably an IOException when reading from the stream.\nCheck logfile for a message \"getResponseBody failed\" and stack trace.\n\nMaybe we should change getResponseBody to re-throw the IOException and not just\nreturn null if there is a problem.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=oglueck",
            "name": "oglueck",
            "key": "oglueck",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Ortwin Glueck",
            "active": true,
            "timeZone": "Europe/Zurich"
          },
          "created": "2002-10-07T15:10:50.000+0000",
          "updated": "2002-10-07T15:10:50.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333672/comment/12379645",
          "id": "12379645",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=oleg.kalnichevski%40bearingpoint.com",
            "name": "oleg.kalnichevski@bearingpoint.com",
            "key": "oleg.kalnichevski@bearingpoint.com",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10453",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10453",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10453",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10453"
            },
            "displayName": "oleg.kalnichevski@bearingpoint.com",
            "active": false,
            "timeZone": "Etc/UTC"
          },
          "body": "Making getResponseBody() to re-throw IOException would probably be a reasonable\nthing to do from the design standpoint, however, it would have required change\nof HttpMethod interface and impacted quite a few classes. For the time being, I\nhave made code in HttpMethodBase.getResponseBodyAsString a bit more defensive.\nAs we are going to revise all the buffering logic in the future, anyways, I mark\nthis bug as resolved",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=oleg.kalnichevski%40bearingpoint.com",
            "name": "oleg.kalnichevski@bearingpoint.com",
            "key": "oleg.kalnichevski@bearingpoint.com",
