        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12375488/comment/12520468",
          "id": "12520468",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=abbierwolf",
            "name": "abbierwolf",
            "key": "abbierwolf",
            "avatarUrls": {
