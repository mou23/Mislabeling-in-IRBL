          "id": "12520387",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=clombart",
            "name": "clombart",
            "key": "clombart",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
