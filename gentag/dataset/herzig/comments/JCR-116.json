            "key": "fgiust",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=fgiust&avatarId=14337",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=fgiust&avatarId=14337",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=fgiust&avatarId=14337",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=fgiust&avatarId=14337"
            },
            "displayName": "Fabrizio Giustina",
            "active": true,
            "timeZone": "Europe/Rome"
          },
          "body": "the maven eclipse plugin DOES add addiction paths for generated files, but only if you are using maven in order to generate java source files.\nActually during jackrabbit build javacc is called using an ant task, and not using the standar maven javacc plugin http://maven.apache.org/reference/plugins/javacc/index.html\n\nI suppose also the IDEA plugin should support generate sources dir, if the maven javacc plugin is used.\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=fgiust",
            "name": "fgiust",
            "key": "fgiust",
            "avatarUrls": {
