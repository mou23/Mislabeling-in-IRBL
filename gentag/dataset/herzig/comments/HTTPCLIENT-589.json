              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "James Murty",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2006-06-29T20:56:56.000+0000",
          "updated": "2006-06-29T20:56:56.000+0000"
        },
        {
