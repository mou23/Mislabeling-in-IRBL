          "updated": "2010-03-29T14:36:04.788+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12460536/comment/12874244",
          "id": "12874244",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
