          "body": "Simple patch -- adds IWC.set/getReaderTermsIndexDivisor.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
