            "timeZone": "America/New_York"
          },
          "created": "2010-03-29T14:03:54.178+0000",
          "updated": "2010-03-29T14:03:54.178+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12460536/comment/12850928",
          "id": "12850928",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=earwin",
            "name": "earwin",
            "key": "earwin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Earwin Burrfoot",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "That's likely orthogonal.\nIf you want all IW readers to have same divisor - shove it into IWC and it's all done.\nIf you want to use different divisors when returning SR as a part of NRT reader and using it inside (say, for deletions) - okay, you'll have the ability to do that at the cost of partial SR reload - shove two settings into IWC and it's done.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=earwin",
            "name": "earwin",
            "key": "earwin",
            "avatarUrls": {
