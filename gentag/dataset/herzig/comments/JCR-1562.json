              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Naresh Gangapur",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2008-05-06T20:54:49.180+0000",
