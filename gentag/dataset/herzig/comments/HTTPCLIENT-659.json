    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12371339/comment/12503178",
          "id": "12503178",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=heron",
            "name": "heron",
            "key": "heron",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Daniel M\u00fcller",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "the patch introduces a package locale SimpleDateFormatFactory which does cache instances of SimpleDateFormat threadlocal",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=heron",
            "name": "heron",
            "key": "heron",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Daniel M\u00fcller",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-06-10T13:52:10.394+0000",
          "updated": "2007-06-10T13:52:10.394+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12371339/comment/12503186",
          "id": "12503186",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "I personally tend to avoid usingthreadlocals in libraries but in this case it seems justified. If I hear no objections, I'll commit the patch\n\nOleg",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2007-06-10T16:59:38.262+0000",
          "updated": "2007-06-10T16:59:38.262+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12371339/comment/12503188",
          "id": "12503188",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "If there are many threads making few calls each to this method, we are opening a memory hole. In particular since a whole map of formats is stored. Can we please wrap the map in a SoftReference to allow garbage collection?\n\nThere is an @Override in the source code, and not inside a comment. I don't know what it's supposed to mean, but it is not valid Java 1.3 source.\n\ncheers,\n  Roland\n\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
