              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2007-06-17T15:56:27.627+0000",
          "updated": "2007-06-17T15:56:27.627+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12371339/comment/12535951",
          "id": "12535951",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Oleg Kalnichevski",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "A small variation on the Daniel's original patch. HashMaps containing date format instances are now softly referecned by the thread local to allow for their garbage-collection. Please review.\n\nIf I hear no complaints, I'll check in the patch in a few days.\n\nOleg  \n ",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=olegk",
            "name": "olegk",
            "key": "olegk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
