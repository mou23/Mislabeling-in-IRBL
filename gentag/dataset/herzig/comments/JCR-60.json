        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/30706/comment/60590",
          "id": "60590",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ppiegaze",
            "name": "ppiegaze",
            "key": "ppiegaze",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Peeter Piegaze",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "The spec does not define any rules for how inheritance among node types works because it was judged to be part of node type creation,, which is outside the scope of the spec.\n\nOf course, maybe this judgement was wrong, but that was the original reason.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ppiegaze",
            "name": "ppiegaze",
            "key": "ppiegaze",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Peeter Piegaze",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2005-03-10T22:22:03.000+0000",
          "updated": "2005-03-10T22:22:03.000+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/30706/comment/60592",
          "id": "60592",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=ppiegaze",
            "name": "ppiegaze",
            "key": "ppiegaze",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
