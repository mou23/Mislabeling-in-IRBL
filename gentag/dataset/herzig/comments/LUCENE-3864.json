    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12546051/comment/13227289",
          "id": "13227289",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "patch mostly works... TestPostingsOffsets passes but now i see that term-vectors cross-compare is awesome...\n\nso there's still another bug.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2012-03-12T02:06:37.793+0000",
          "updated": "2012-03-12T02:06:37.793+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12546051/comment/13227291",
          "id": "13227291",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "stupid bug: not returning -1 for startOffset when they aren't available.\n\nCheckIndex only wraps its entire offsets check in if (hasOffsets), which was confusing to me, but thats referring to whether the vectors have offsets...\n\n(in other words my postings impl can return -1 always for offsets and checkindex is happy..., in fact there are no assertions for postings offsets at all!)",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2012-03-12T02:18:59.922+0000",
          "updated": "2012-03-12T02:18:59.922+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12546051/comment/13227292",
          "id": "13227292",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "to improve checkindex: i guess there really isn't much we can enforce, but I think in testPostings we should\nat least try to pull a docsAndPositions(offsets=true) if they are available.\n\nin the case they aren't available we can also assert -1 for start and end offset, which would have caught my bug :)",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2012-03-12T02:22:04.250+0000",
          "updated": "2012-03-12T02:22:04.250+0000"
        },
        {
