    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12458102/comment/13145559",
          "id": "13145559",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "OK, as far as I can tell, we need a way to transport the user data over HTTP. Does anybody have a better idea then a custom HTTP header?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2011-11-07T15:36:09.127+0000",
          "updated": "2011-11-07T15:36:09.127+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12458102/comment/13146115",
          "id": "13146115",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "i would not use a custom header (but didn't yet think about a better idea ;)",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=angela",
            "name": "angela",
            "key": "anchela",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Angela Schreiber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2011-11-08T07:24:46.734+0000",
          "updated": "2011-11-08T07:24:46.734+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12458102/comment/13146173",
          "id": "13146173",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "I agree we should avoid a custom header, but I do think we need to put it into a header, so that it can be requested with all requests, including PUT and POST...\n\nWe could avoid using a new header by claiming that the User Data is a related resource, and put it into a link header field with an extension link relation, roughly like that:\n\nLink: <data:,my%20user%20data>; rel=\"...\"\n\n(with ... a suitable URI for \"JCR user data\").\n\nSee RFCs 2397 and 5988.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=reschke&avatarId=52677",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=reschke&avatarId=52677",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=reschke&avatarId=52677"
            },
            "displayName": "Julian Reschke",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2011-11-08T08:57:59.728+0000",
          "updated": "2011-11-08T08:57:59.728+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12458102/comment/13146285",
          "id": "13146285",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=reschke",
            "name": "reschke",
            "key": "reschke",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=reschke&avatarId=52677",
