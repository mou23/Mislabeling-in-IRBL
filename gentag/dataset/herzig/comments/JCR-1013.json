              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Marcel  May",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-07-09T17:54:06.798+0000",
          "updated": "2007-07-09T17:54:06.798+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12373094/comment/12553310",
          "id": "12553310",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=jukkaz",
            "name": "jukkaz",
            "key": "jukkaz",
