    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12497978/comment/12991957",
          "id": "12991957",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "after applying the patch, you have to run 'ant jflex' from modules/analysis/common and 'ant genrbbi' from modules/analysis/icu to regenerate.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=rcmuir&avatarId=10150",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=rcmuir&avatarId=10150",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=rcmuir&avatarId=10150"
            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2011-02-08T12:59:22.618+0000",
          "updated": "2011-02-08T12:59:22.618+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12497978/comment/12992014",
          "id": "12992014",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "The generated top-level domain macro file has a bunch of new entries when I run this, but these are not included in your patch, and I think we should keep this list up-to-date.\n\nThe patch is missing HangulSupp macro generation in modules/icu/src/tools/.../GenerateJFlexSupplementaryMacros.java, but since the Hangul macro is not used in the jflex grammar, this doesn't cause a problem.\n\nIt would be nice to remove the hard-coded ranges for the intersection of Hangul & ALetter, but when I tried to use JFlex negation and union to produce the equivalent, memory usage exploded and I couldn't get JFlex to generate, so I guess we'll have to wait on native JFlex supplementary character support before we can change it.\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=sarowe",
            "name": "sarowe",
            "key": "steve_rowe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=steve_rowe&avatarId=37258",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=steve_rowe&avatarId=37258",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=steve_rowe&avatarId=37258",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&ownerId=steve_rowe&avatarId=37258"
            },
            "displayName": "Steven Rowe",
            "active": true,
            "timeZone": "America/New_York"
          },
          "created": "2011-02-08T15:50:03.247+0000",
          "updated": "2011-02-08T15:50:03.247+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12497978/comment/12992066",
          "id": "12992066",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
