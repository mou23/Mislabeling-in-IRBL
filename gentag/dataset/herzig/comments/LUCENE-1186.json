            },
            "displayName": "Christian Kohlsch\u00fctter",
            "active": true,
            "timeZone": "America/Los_Angeles"
          },
          "created": "2008-02-25T14:34:17.821+0000",
          "updated": "2008-02-25T14:34:17.821+0000"
