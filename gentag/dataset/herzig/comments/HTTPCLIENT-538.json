        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12334097/comment/12382924",
          "id": "12382924",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=paulk",
            "name": "paulk",
            "key": "paulk",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=paulk&avatarId=23366",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&ownerId=paulk&avatarId=23366",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&ownerId=paulk&avatarId=23366",
