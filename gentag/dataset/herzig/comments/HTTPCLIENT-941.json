          "id": "12870587",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=vwdiesel",
            "name": "vwdiesel",
            "key": "vwdiesel",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
