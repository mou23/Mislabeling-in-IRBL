    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12363236/comment/12514414",
          "id": "12514414",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "this will go into an extra issue:\n- use wait/notify instead of Thread.interrupt() to unblock waiting threads\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-07-21T14:00:26.436+0000",
          "updated": "2007-07-21T14:00:26.436+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12363236/comment/12514455",
          "id": "12514455",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Replacing the shared cleanup thread with a per-pool thread raises some tricky issues.\nThe first attempt failed because the background thread prevents GC of the connection manager:\nthe thread keeps a reference to the ConnectionPool, which is a nested class of the TSCCM.\n\nWill need to think about this a little more. Suggestions are welcome.\n\ncheers,\n  Roland\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-07-22T04:00:54.439+0000",
          "updated": "2007-07-22T04:00:54.439+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12363236/comment/12514671",
          "id": "12514671",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "next steps:\n- move TSCCM to a separate package\n- factor out some of the inner classes\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2007-07-23T16:32:57.419+0000",
          "updated": "2007-07-23T16:32:57.419+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12363236/comment/12516052",
          "id": "12516052",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Roland Weber",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Done. The connection pool, now a separate class, no longer keeps a hard reference to the connection manager.\nThe pool keeps a weak reference to the manager to detect GC. In that case, the pool shuts itself down.\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rolandw",
            "name": "rolandw",
            "key": "rolandw",
            "avatarUrls": {
