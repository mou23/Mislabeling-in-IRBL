          "body": "I have already starting working on a patch, still needs a little testing.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=edouard.hue",
            "name": "edouard.hue",
            "key": "edouard.hue",
            "avatarUrls": {
