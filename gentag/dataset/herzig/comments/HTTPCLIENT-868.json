        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12433507/comment/12745485",
          "id": "12745485",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=nsushkin",
            "name": "nsushkin",
            "key": "nsushkin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Nicholas Sushkin",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "I looked at the stylesheet above, it already had the code to generate anchors. What do you mean \"we happily accept pathces\". Is that the wrong stylesheet? Which stylesheet generates the site?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=nsushkin",
            "name": "nsushkin",
            "key": "nsushkin",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Nicholas Sushkin",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2009-08-20T16:39:05.028+0000",
