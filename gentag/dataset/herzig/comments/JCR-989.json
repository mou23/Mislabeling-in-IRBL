        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12372505/comment/12519668",
          "id": "12519668",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mreutegg",
            "name": "mreutegg",
            "key": "mreutegg",
