        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12344393/comment/12416474",
          "id": "12416474",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=edgarpoce",
            "name": "edgarpoce",
            "key": "edgarpoce",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
