            },
            "displayName": "Robert Muir",
            "active": true,
            "timeZone": "America/New_York"
          },
          "body": "this issue is *not* broken by LUCENE-3624.\n\nPrior to LUCENE-3624, you just got a NullPointerException instead of a UnsupportedOperationException!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!\n",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=rcmuir",
            "name": "rcmuir",
            "key": "rcmuir",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?ownerId=rcmuir&avatarId=10150",
