              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael Becke",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2004-07-04T04:57:01.000+0000",
