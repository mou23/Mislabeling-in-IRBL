    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12409103/comment/12650463",
          "id": "12650463",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=michaelbusch",
            "name": "michaelbusch",
            "key": "michaelbusch",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael Busch",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "Simple patch that adds two methods to OpenBitSetIterator: nextDoc() and next(int). These work just as next() and skipTo(int) with the difference that they return the new docId instead of true/false.\n\nAlso improves the unit tests to test the new methods and moves testBitUtils() from Solr into Lucene. \n\nAll tests pass. I'm planning to commit this in a day or so.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=michaelbusch",
            "name": "michaelbusch",
            "key": "michaelbusch",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Michael Busch",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2008-11-25T05:13:52.589+0000",
          "updated": "2008-11-25T05:13:52.589+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12409103/comment/12650517",
          "id": "12650517",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=mikemccand",
            "name": "mikemccand",
            "key": "mikemccand",
            "avatarUrls": {
