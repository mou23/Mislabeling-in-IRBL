    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12425475/comment/12709793",
          "id": "12709793",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "i identified the following changes to the CND grammar since PRD:\n\n- property types are now  all exclusively uppercase \n- OPV flags  are now all exclusively uppercase\n- new keyword 'sns' on node defs (used to be 'multiple' | 'mult')\n- new 'primaryitem' attribute on node type (used to be 'primary' | 'prim' \n  attribute on prop/node def)\n- additional 'query' | 'q' on node type (used to be 'noquery' | 'nq')\n- '?' in various places indicating implementation variants",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=stefan%40jira",
            "name": "stefan@jira",
            "key": "stefan@jira",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Stefan Guggisberg",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "created": "2009-05-15T10:02:47.266+0000",
          "updated": "2009-05-15T15:41:53.308+0000"
        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12425475/comment/12709799",
          "id": "12709799",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=fmeschbe",
            "name": "fmeschbe",
            "key": "fmeschbe",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Felix Meschberger",
            "active": true,
            "timeZone": "Europe/Berlin"
          },
          "body": "> now all exclusively uppercase \n\nWelcome back, good ol' COBOL times ;-)\n\nWill there be backwards compatibility support ? Like supporting non-all-uppercase property types and OPV flags ? Or old key words ?",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=fmeschbe",
            "name": "fmeschbe",
