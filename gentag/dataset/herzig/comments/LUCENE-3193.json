    "comment": {
      "comments": [
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12509910/comment/13047896",
          "id": "13047896",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=shaie",
