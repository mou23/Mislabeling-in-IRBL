        },
        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12333876/comment/12829675",
          "id": "12829675",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=pak",
            "name": "pak",
            "key": "pak",
            "avatarUrls": {
