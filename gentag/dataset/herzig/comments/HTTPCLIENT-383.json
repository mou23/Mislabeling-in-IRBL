            },
            "displayName": "Michael Becke",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "body": "I agree that the HttpMethod interface is not pretty, but we also don't want to make to make it any \nworse.  My preference would be to leave out the HttpHost API changes.\n\nMike",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=becke%40u.washington.edu",
            "name": "becke@u.washington.edu",
            "key": "becke@u.washington.edu",
