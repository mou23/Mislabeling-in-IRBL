          "body": "Bernhard,\n\nI'll try looking at this some time this week.  Did you run your performance\ntests against the code with these changes applied?  What is the performance gain\nnow?\n\nThanks.",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=otis%40apache.org",
            "name": "otis@apache.org",
            "key": "otis@apache.org",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
              "16x16": "https://issues.apache.org/jira/secure/useravatar?size=xsmall&avatarId=10452",
              "32x32": "https://issues.apache.org/jira/secure/useravatar?size=medium&avatarId=10452"
            },
            "displayName": "Otis Gospodnetic",
            "active": true,
            "timeZone": "Etc/UTC"
          },
          "created": "2004-08-23T20:18:30.000+0000",
