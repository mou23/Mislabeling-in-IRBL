          "body": "Committed 3.0 branch revision: 1028915\nCommitted 2.9 branch revision: 1028918",
          "updateAuthor": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=uschindler",
            "name": "uschindler",
            "key": "thetaphi",
