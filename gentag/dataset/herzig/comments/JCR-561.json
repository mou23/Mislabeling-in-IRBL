        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12349177/comment/12432487",
          "id": "12432487",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=fmeschbe",
            "name": "fmeschbe",
