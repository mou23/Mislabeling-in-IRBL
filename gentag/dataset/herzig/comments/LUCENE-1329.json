        {
          "self": "https://issues.apache.org/jira/rest/api/2/issue/12399721/comment/12624634",
          "id": "12624634",
          "author": {
            "self": "https://issues.apache.org/jira/rest/api/2/user?username=eksdev",
            "name": "eksdev",
            "key": "eksdev",
            "avatarUrls": {
              "48x48": "https://issues.apache.org/jira/secure/useravatar?avatarId=10452",
              "24x24": "https://issues.apache.org/jira/secure/useravatar?size=small&avatarId=10452",
